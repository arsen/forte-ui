{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^docgen"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    // Never cached. These six scripts write CHECKED-IN files, so a cache hit on
    // an unchanged input set would leave a hand-edit to tokens.color.css or
    // registry.ts sitting in the tree -- the exact drift `pnpm generate` exists
    // to repair. They run in a couple of seconds; caching buys nothing and
    // costs the guarantee.
    //
    // `^generate` orders the two packages, and it is load-bearing as of
    // build-catalog.mjs: that script reads the library's docs-data/components.json
    // to resolve every component page, so running the pair in parallel -- which
    // is what this task did before, and the comment here used to promise -- would
    // let a run that ADDS a component read the previous run's catalog and emit
    // a site index missing the very page that run created. Depending on
    // `generate` rather than `docgen` is what keeps the library's own chain from
    // running its slowest script twice.
    "generate": {
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "tokens": {
      "outputs": [
        "src/styles/tokens.color.css",
        "src/styles/motion.css"
      ]
    },
    "docgen": {
      "outputs": [
        "docs-data/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    }
  }
}

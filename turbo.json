{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^docgen"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    // Never cached. These five scripts write CHECKED-IN files, so a cache hit
    // on an unchanged input set would leave a hand-edit to tokens.color.css or
    // registry.ts sitting in the tree -- the exact drift `pnpm generate` exists
    // to repair. They run in well under a second; caching buys nothing and
    // costs the guarantee. No dependsOn either: neither docs generator reads
    // anything the library builds, so both packages run in parallel.
    "generate": {
      "cache": false
    },
    "tokens": {
      "outputs": [
        "src/styles/tokens.color.css",
        "src/styles/motion.css"
      ]
    },
    "docgen": {
      "outputs": [
        "docs-data/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    }
  }
}

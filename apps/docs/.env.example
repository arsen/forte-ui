# Firebase Analytics for the docs site. Copy to `.env.local` (gitignored) and
# fill in the values from the Firebase console: Project settings → Your apps →
# SDK setup and configuration. Every key is `NEXT_PUBLIC_*` because the site is
# a static export — the values are inlined into the HTML at BUILD time, so set
# them before `pnpm build`, and rebuild when they change.
#
# Leave the file absent and the site simply does not track: `Analytics` mounts
# nothing without a measurement id, so a fork or a local checkout never reports
# into somebody else's property. Nothing here is a secret — a Firebase web
# config is shipped to every browser by design — but the env keeps a fork's
# build from pointing at the upstream project by default.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
